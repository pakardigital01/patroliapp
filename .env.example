# Supabase — sudah dipra-konfigurasi otomatis oleh Bolt
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Secret untuk Edge Functions (atur di dashboard Supabase > Edge Functions > Secrets):
# AES_KEY_HEX        — kunci AES-256-GCM dalam hex (64 karakter). Buat dengan: openssl rand -hex 32
# RESEND_API_KEY     — API key Resend untuk pengiriman email laporan
# FROM_EMAIL         — alamat email pengirim laporan (mis. patroli@resend.dev)

# Admin seed (jalankan sekali, lihat README):
# ADMIN_EMAIL=admin@patroli.id
# ADMIN_PASSWORD=Patroli2026!
